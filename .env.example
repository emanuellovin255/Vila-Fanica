# ============================================================
# Variabilele de mediu ale unui site de cazare.
#
# Se copiază ca `.env.local` pe laptop și se pun, aceleași, în
# Vercel → Project → Settings → Environment Variables.
#
# REGULI.md 6: niciun secret nu ajunge în repo și nimic nu primește
# prefixul NEXT_PUBLIC_ decât dacă valoarea e cu adevărat publică.
# Tot ce are NEXT_PUBLIC_ mai jos ajunge în bundle-ul din browser și
# oricine îl poate citi — de asta sunt doar chei publice, prin design.
# ============================================================


# ------------------------------------------------------------
# 1 · Site
# ------------------------------------------------------------

# Originul canonic al site-ului, fără slash la final.
# Folosit la canonical, sitemap.xml, hreflang, og:url și la CORS same-origin.
# OBLIGATORIU în producție. Ex: https://pensiunea-exemplu.ro
NEXT_PUBLIC_SITE_URL=

# Numele locației, așa cum apare în emailul de notificare.
# Același motor rulează pe toate site-urile; asta le deosebește în inbox.
# Opțional — implicit se ia din date/01-nume-logo-si-descriere.md.
SITE_NAME=


# ------------------------------------------------------------
# 2 · Formular → email (T10). Fără bază de date.
# ------------------------------------------------------------

# Cheia API Resend. resend.com → API Keys → Create.
# OBLIGATORIE ca formularul să trimită ceva. Fără ea, submit-ul
# răspunde 200 și scrie în log — util în dezvoltare, inutil în producție.
RESEND_API_KEY=

# Expeditorul emailurilor. Domeniul trebuie verificat în Resend
# (SPF + DKIM), altfel mesajele ajung în spam.
# Ex: rezervari@pensiunea-exemplu.ro
FORMULAR_EXPEDITOR=

# Destinatarul cererilor de cazare — adresa locației.
# Mai multe adrese se separă cu virgulă. OBLIGATORIU.
FORMULAR_DESTINATAR=

# Opțional: notificare WhatsApp la fiecare cerere nouă (CallMeBot).
# La o cabană unde telefonul e canalul principal, chiar e util.
# Ambele goale = notificarea WhatsApp nu se trimite.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=


# ------------------------------------------------------------
# 3 · Cloudflare Turnstile (T09)
# ------------------------------------------------------------

# Cheia publică (site key). Ajunge în HTML prin design — e publică.
# dash.cloudflare.com → Turnstile → Add site.
# Goală = widget-ul nu se randează și verificarea se sare (dezvoltare).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cheia secretă. Verificarea token-ului se face SERVER-SIDE cu ea.
# Un token verificat doar în browser nu înseamnă nimic.
# Goală în producție = formularul e apărat doar de honeypot + rate limit.
TURNSTILE_SECRET_KEY=


# ------------------------------------------------------------
# 4 · Rate limit persistent (T09)
# ------------------------------------------------------------

# Upstash Redis. Funcțiile serverless sunt stateless: o limită ținută
# în memorie se resetează la fiecare instanță nouă, deci nu limitează
# nimic. Cu Upstash, limita ține între instanțe.
# console.upstash.com → Create Database → REST API.
# Goale = se cade pe limitare în memorie, cu avertisment în log.
# Acceptabil pe un formular de contact. NU pe endpoint-ul de plată.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------------------------------------------------------------
# 4b · Motor de rezervări → CSP frame-src (T09/T12)
# ------------------------------------------------------------

# Originul motorului de rezervări încadrat în iframe (ex: Bookingjini,
# package de la lanț etc.). CSP-ul din middleware permite EXACT acest
# origin în `frame-src`, nimic altceva — fără wildcard.
# Sursa de adevăr rămâne date/10-rezervari-si-plati.md (booking.engineUrl);
# aici e doar pentru edge, care nu poate citi fișiere. T12 le leagă.
# Doar originul, fără cale: https://rezervari.exemplu.ro
# Gol = niciun iframe extern permis.
BOOKING_ENGINE_ORIGIN=


# ------------------------------------------------------------
# 5 · Plăți Netopia (T13) — implicit OPRIT
# ------------------------------------------------------------
#
# Modulul e doar interfață în faza 1. Se completează la primul client
# care chiar încasează online. Vezi module/plati-netopia/CITESTE-MA.md.
#
# Nu atingem niciodată datele cardului: redirect către pagina găzduită
# de Netopia. Așa rămânem la SAQ-A, cel mai simplu nivel PCI-DSS.

# 'sandbox' sau 'live'. Se testează integral în sandbox întâi.
NETOPIA_MEDIU=sandbox

# Semnătura POS-ului. Netopia → Admin → Puncte de vânzare.
NETOPIA_SIGNATURE=

# Cheia API v2. doc.netopia-payments.com/docs/get-started/
NETOPIA_API_KEY=

# Cheia publică Netopia, pentru verificarea semnăturii IPN-ului.
# Fără verificare de semnătură, oricine poate trimite o notificare
# falsă de „plătit". E cel mai important punct din tot modulul.
NETOPIA_PUBLIC_KEY=

# URL-ul de callback IPN, absolut.
# Ex: https://pensiunea-exemplu.ro/api/plati/ipn
NETOPIA_IPN_URL=


# ------------------------------------------------------------
# 6 · Bază de date — apare DOAR cu plăți online (T13)
# ------------------------------------------------------------
#
# Implicit sistemul nu stochează nimic (REGULI.md 15). Formularul
# trimite email, rezervările stau în sistemul lor.
# Regiune UE, obligatoriu. Neon sau Vercel Postgres.
# Accesată exclusiv server-side. Niciodată NEXT_PUBLIC_.
DATABASE_URL=


# ------------------------------------------------------------
# 7 · Analytics — se încarcă doar după accept (T11)
# ------------------------------------------------------------

# ID-ul de măsurare. Goală = nu se încarcă nimic, niciodată.
# Chiar și completată, scriptul nu pleacă înainte de acceptul din
# bannerul de cookies. Un banner care apare după ce Analytics deja
# rula nu e conform.
NEXT_PUBLIC_ANALYTICS_ID=


# ------------------------------------------------------------
# Ce NU intră aici, intenționat
# ------------------------------------------------------------
# Telefonul, emailul, adresa și CUI-ul locației nu sunt secrete și nu
# sunt variabile de mediu. Stau în clienti/<nume>/date/02-telefon-email-si-adresa.md și
# 12-firma-si-documente-legale.md, ca să le poată edita cineva care nu programează
# (REGULI.md 5).


# ------------------------------------------------------------
# 8 · Panoul de administrare (/admin)
# ------------------------------------------------------------
# Pașii completați, cu tot ce trebuie apăsat: ADMIN.md din rădăcină.
#
# Fără ADMIN_PAROLA și ADMIN_SECRET, panoul e ÎNCHIS — nu „deschis fără
# parolă". O configurare incompletă nu are voie să devină o ușă deschisă.

# Parola cu care intră gazda. O alege ea și o scrie direct în Vercel:
# nu trece prin repo și nu trece prin nimeni altcineva.
ADMIN_PAROLA=

# Șir aleator, cu care se semnează cookie-ul de sesiune. Se generează o
# dată, cu `openssl rand -base64 32`, și nu se mai citește niciodată.
# Schimbat, închide toate sesiunile deschise — singurul mod de a
# „deconecta de pe toate dispozitivele".
ADMIN_SECRET=

# Token GitHub *fine-grained*, cu acces la UN SINGUR repo (acesta) și o
# singură permisiune: Contents → Read and write. Nu ajunge niciodată în
# browser: tot ce vine de la panou trece prin app/api/admin/.
#
# GOL în dezvoltare: fără el, panoul scrie direct în fișierele de pe
# disc (lib/admin/depozit.ts), deci se poate proba tot fără credențiale.
# Pe Vercel, lipsa lui e o eroare — discul funcției nu e permanent — și
# panoul o spune pe ecran, la Setări.
ADMIN_GITHUB_TOKEN=

# Repo-ul în care scrie panoul, ca `utilizator/repo`.
ADMIN_GITHUB_REPO=

# Ramura. Gol = main.
ADMIN_GITHUB_BRANCH=
